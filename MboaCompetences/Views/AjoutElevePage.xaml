<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MboaCompetences.ViewModels"
             x:Class="MboaCompetences.Views.AjoutElevePage"
             x:DataType="vm:AjoutEleveViewModel"
             Title="Nouvel enfant">

    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="👧👦" FontSize="52" HorizontalOptions="Center" />

        <Label Text="Prénom" Style="{StaticResource Etiquette}" />
        <Border Style="{StaticResource Carte}" Padding="12,2">
            <Entry x:Name="ChampPrenom" Text="{Binding Prenom}" Placeholder="Prénom de l'enfant" FontSize="18"
                   AutomationId="champPrenom" ReturnType="Done" />
        </Border>

        <Label Text="Niveau" Style="{StaticResource Etiquette}" />
        <Border Style="{StaticResource Carte}" Padding="12,2">
            <Picker ItemsSource="{Binding Niveaux}" SelectedIndex="{Binding NiveauIndex}" Title="Niveau" FontSize="18"
                    TextColor="{StaticResource Texte}" />
        </Border>
        <Label Text="SIL : Section d'Initiation au Langage · CP · CE1 · CE2 · CM1 · CM2" Style="{StaticResource Gris}" />

        <Button Text="Enregistrer ✓" Style="{StaticResource BoutonPrincipal}" Margin="0,10,0,0"
                IsEnabled="{Binding PeutEnregistrer}" Command="{Binding EnregistrerCommand}" />
        <Button Text="Annuler" Style="{StaticResource BoutonSecondaire}" Command="{Binding AnnulerCommand}" />
    </VerticalStackLayout>
</ContentPage>
