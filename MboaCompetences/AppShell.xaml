<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MboaCompetences.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MboaCompetences.Views"
    FlyoutBehavior="Disabled"
    Title="MboaCompétences">

    <TabBar>
        <ShellContent Title="Élèves" Icon="tab_eleves" Route="eleves"
                      ContentTemplate="{DataTemplate views:ElevesPage}" />
        <ShellContent Title="Exercices" Icon="tab_exercices" Route="accueil"
                      ContentTemplate="{DataTemplate views:AccueilPage}" />
        <ShellContent Title="Parent" Icon="tab_parent" Route="parent"
                      ContentTemplate="{DataTemplate views:ParentPage}" />
    </TabBar>
</Shell>
