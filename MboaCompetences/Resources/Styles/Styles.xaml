<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Fond}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Titre" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource VertFonce}" />
    </Style>

    <Style x:Key="Etiquette" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TexteGris}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="Gris" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TexteGris}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Carte}" />
        <Setter Property="Stroke" Value="{StaticResource Bord}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="BoutonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Vert}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="48" />
        <Style.Triggers>
            <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                <Setter Property="BackgroundColor" Value="{StaticResource FeuGris}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource Vert}" />
        <Setter Property="BorderColor" Value="{StaticResource Vert}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="BoutonJaune" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Jaune}" />
        <Setter Property="TextColor" Value="#3A2F00" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style x:Key="BoutonRouge" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Rouge}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Texte}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TexteGris}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Vert}" />
        <Setter Property="Shell.ForegroundColor" Value="White" />
        <Setter Property="Shell.TitleColor" Value="White" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="White" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Vert}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Vert}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TexteGris}" />
    </Style>
</ResourceDictionary>
